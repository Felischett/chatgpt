<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Messanger.Views.RegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Registrieren">

    <Grid>
        <ScrollView>
            <VerticalStackLayout
                Padding="24"
                Spacing="18"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="700">

                <Label
                    Text="Registrieren"
                    Style="{StaticResource TitleLabel}"
                    Margin="0,10,0,10" />

                <Frame Padding="22">
                    <VerticalStackLayout Spacing="14">

                        <Label
                            Text="Username"
                            TextColor="{StaticResource SecondaryTextColor}" />

                        <Entry
                            x:Name="UsernameEntry"
                            Placeholder="Username"
                            Text="{Binding Username}"
                            ReturnType="Next"
                            Completed="OnUsernameCompleted" />

                        <Label
                            Text="E-Mail"
                            TextColor="{StaticResource SecondaryTextColor}" />

                        <Entry
                            x:Name="EmailEntry"
                            Placeholder="E-Mail"
                            Keyboard="Email"
                            Text="{Binding Email}"
                            ReturnType="Next"
                            Completed="OnEmailCompleted" />

                        <Label
                            Text="Passwort"
                            TextColor="{StaticResource SecondaryTextColor}" />

                        <Entry
                            x:Name="PasswordEntry"
                            Placeholder="Passwort"
                            IsPassword="True"
                            Text="{Binding Password}"
                            ReturnType="Go"
                            Completed="OnPasswordCompleted" />

                        <Label
                            Text="{Binding Message}"
                            TextColor="Red"
                            LineBreakMode="WordWrap"
                            HorizontalOptions="Center" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />

                        <Button
                            Text="Account erstellen"
                            Command="{Binding RegisterCommand}" />

                        <Grid ColumnDefinitions="Auto,Auto" HorizontalOptions="Center" ColumnSpacing="6">
                            <Label
                                Grid.Column="0"
                                Text="Schon ein Konto?"
                                TextColor="{StaticResource SecondaryTextColor}" />
                            <Label
                                Grid.Column="1"
                                Text="Login"
                                TextColor="{StaticResource PrimaryColor}"
                                FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLoginTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
