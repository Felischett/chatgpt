<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Messanger.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid>
        <ScrollView>
            <VerticalStackLayout 
                Padding="24, 80, 24, 24" 
                Spacing="18" 
                MaximumWidthRequest="2000" 
                HorizontalOptions="Center">

                <Label 
                    Text="Einstellungen" 
                    Style="{StaticResource TitleLabel}" 
                    HorizontalOptions="Center" />

                <Frame Padding="22" CornerRadius="10">
                    <VerticalStackLayout Spacing="14">

                        <Label 
                            Text="Übersetzungs-Zielsprache (z.B. DE, EN, IT)" 
                            TextColor="{StaticResource SecondaryTextColor}" />

                        <Entry 
                            Placeholder="DE" 
                            Text="{Binding TargetLang}" />

                        <Button 
                            Text="Speichern" 
                            Command="{Binding SaveCommand}" />

                        <Label 
                            Text="{Binding Message}" 
                            TextColor="{StaticResource SecondaryTextColor}" 
                            HorizontalOptions="Center" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <Button
            Text="Home"
            Clicked="HomeWhenClicked"
            FontSize="12"
            HeightRequest="40"
            WidthRequest="70"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="15"
            BackgroundColor="{StaticResource Gray200}"
            TextColor="Black" />

    </Grid>
</ContentPage>