<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="Messanger.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Application.Resources>

        <ResourceDictionary>

            <!-- Farben -->
            <Color x:Key="PrimaryColor">#4F46E5</Color>
            <Color x:Key="SecondaryColor">#6366F1</Color>
            <Color x:Key="BackgroundColor">#F3F4F6</Color>
            <Color x:Key="CardColor">#FFFFFF</Color>
            <Color x:Key="TextColor">#111827</Color>
            <Color x:Key="SecondaryTextColor">#6B7280</Color>

            <!-- Page Style -->
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundColor}" />
            </Style>

            <!-- Label Title -->
            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="HorizontalOptions" Value="Center" />
                <Setter Property="Margin" Value="0,10,0,20"/>
            </Style>

            <!-- Normal Label -->
            <Style TargetType="Label">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="TextColor" Value="{StaticResource TextColor}"/>
            </Style>

            <!-- Entry Style -->
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
                <Setter Property="TextColor" Value="{StaticResource TextColor}" />
                <Setter Property="Margin" Value="0,5"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <!-- Button Style -->
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="HeightRequest" Value="50"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Margin" Value="0,10"/>
            </Style>

            <!-- Frame Card -->
            <Style TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource CardColor}"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Margin" Value="10"/>
                <Setter Property="HasShadow" Value="True"/>
            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>
